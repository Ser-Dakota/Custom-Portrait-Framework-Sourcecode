<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CustomPortraitFramework</AssemblyName>
    <RootNamespace>CustomPortraitFramework</RootNamespace>
    <Product>Custom Portrait Framework</Product>
    <Description>Logs texture and sprite names as they load in Ova Magica.</Description>
    <Version>0.1.0</Version>

    <!-- Override on the command line with: dotnet build -p:GameFolder="D:\Games\Ova Magica" -->
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Users\dakot\Documents\Applications\Steam\steamapps\common\Ova Magica</GameFolder>
    <BepInExFolder>$(GameFolder)\BepInEx</BepInExFolder>
    <InteropFolder>$(BepInExFolder)\interop</InteropFolder>
    <PluginsFolder>$(BepInExFolder)\plugins</PluginsFolder>

    <CopyToPluginsFolder Condition="'$(CopyToPluginsFolder)' == ''">true</CopyToPluginsFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 bleeding-edge IL2CPP host + HarmonyX. The * wildcard pulls
         the newest pre-release published to the BepInEx nuget feed. -->
    <PackageReference Include="BepInEx.Core" Version="6.0.0-be.*" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" />
    <PackageReference Include="HarmonyX" Version="2.13.0" />
  </ItemGroup>

  <!-- IL2CPP interop DLLs generated by BepInEx on first run of the game.
       If this folder doesn't exist yet, launch the game once with BepInEx
       installed and the assemblies will appear here. -->
  <ItemGroup Condition="Exists('$(InteropFolder)')">
    <Reference Include="UnityEngine">
      <HintPath>$(InteropFolder)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropFolder)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(InteropFolder)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(InteropFolder)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropFolder)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Canvas / RectTransform UI core (Canvas.isRootCanvas lives here, not in UI). -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(InteropFolder)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Legacy Input (Input.GetKeyDown) for the diagnostic hotkey. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(InteropFolder)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UI.Text's horizontalOverflow/verticalOverflow return HorizontalWrapMode/
         VerticalWrapMode, which live here. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(InteropFolder)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMeshPro types (TMP_Text) for the text-layout diagnostic. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(InteropFolder)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropFolder)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnMissingInterop" BeforeTargets="CoreCompile" Condition="!Exists('$(InteropFolder)')">
    <Warning Text="IL2CPP interop folder not found at '$(InteropFolder)'. Launch the game once with BepInEx 6 installed so it can generate the interop assemblies, then rebuild." />
  </Target>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(CopyToPluginsFolder)' == 'true' And Exists('$(PluginsFolder)')">
    <MakeDir Directories="$(PluginsFolder)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsFolder)\$(AssemblyName)" />
    <Message Importance="high" Text="Deployed: $(PluginsFolder)\$(AssemblyName)\$(AssemblyName).dll" />
  </Target>

</Project>
